# Copy to .env and fill in your own values. Never commit the real .env.

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# --- Optional AI assistant / web search ---
# Leave blank to run the deterministic core without third-party inference.
# GROQ_API_KEY=
# TAVILY_API_KEY=

# --- Bank sync (Plaid) ---
# Leave blank to use manual accounts and imports without bank sync.
# PLAID_CLIENT_ID=
# PLAID_CLIENT_SECRET=
PLAID_ENVIRONMENT=sandbox
# Inbound-webhook URL (L1). Set to a PUBLICLY REACHABLE https URL ending in
# /api/plaid/webhook so Plaid delivers SYNC_UPDATES_AVAILABLE / ITEM_LOGIN_REQUIRED
# etc. The URL is baked into each item at link time, so items linked BEFORE this is
# set won't deliver until re-linked. Local dev: Plaid can't reach localhost — use an
# https tunnel (e.g. ngrok) and trigger sandbox/item/fire_webhook for testing. Leave
# unset to stay poll-only.
# PLAID_WEBHOOK_URL=https://your-host/api/plaid/webhook
# Dedicated Fernet key (urlsafe-base64, 32 bytes) for encrypting Plaid access
# tokens at rest. REQUIRED in production: if unset, the key is derived from
# JWT_SECRET_KEY, so rotating that secret would make every stored Plaid token
# permanently undecryptable. ROTATION ORDER: set PLAID_TOKEN_KEY (and re-encrypt
# existing tokens) BEFORE rotating JWT_SECRET_KEY.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PLAID_TOKEN_KEY=
#
# Graceful key rotation (L6): ciphertext is stamped enc:v2:<keyid>:… so a row
# records which key encrypted it. To rotate the token key WITHOUT downtime:
#   1. Generate a new key; set it as PLAID_TOKEN_KEY.
#   2. Move the OLD key into PLAID_TOKEN_KEYS_RETIRED (comma-separated; kept for
#      DECRYPTION only — existing rows still decrypt).
#   3. Run:  python -m server.src.services.plaid_reencrypt   (rewrites all rows
#      to the new key; --dry-run to preview).
#   4. Once it reports 0 errors and every row is on the new key, drop the old key
#      from PLAID_TOKEN_KEYS_RETIRED.
# PLAID_TOKEN_KEYS_RETIRED=
#
# After the one-shot plaintext→ciphertext migration has run everywhere, set this
# to true to HARD-FAIL on any remaining legacy plaintext token (closes the
# pre-Step-08 path). Leave false during rollout.
# PLAID_REQUIRE_ENCRYPTED_TOKENS=false

# --- Database ---
# Default (unset) is local SQLite: sqlite:///finance_tracker.db
# Postgres (the multi-tenant target) uses the psycopg 3 driver:
#   DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/finance_tracker
# docker-compose.yml provisions a postgres:16 service; see it for the compose URL.
#
# WS2 Row-Level Security role model (only relevant on Postgres with RLS on):
#  * pf_owner  — owns the schema, BYPASSRLS (or superuser). Runs Alembic
#                migrations + maintenance/scheduler jobs. Migrations create the
#                tenant-isolation policies, so they must run as this role.
#  * pf_app    — NOSUPERUSER, no BYPASSRLS, only CRUD + sequence usage. The
#                FastAPI request engine connects as THIS role so the policies
#                actually enforce (a superuser bypasses RLS even when FORCEd).
# When ENABLE_RLS=true the app MUST connect as a non-superuser (pf_app) AND every
# request must set the tenant — both are wired automatically; you only provision
# the two roles. When ENABLE_RLS is false (default) RLS is fully inert.
# DATABASE_URL=postgresql+psycopg://pf_app:CHANGEME@localhost:5432/finance_tracker
# ALEMBIC_DATABASE_URL=postgresql+psycopg://pf_owner:CHANGEME@localhost:5432/finance_tracker

# --- Row-Level Security (WS2) ---
# Master switch for Postgres tenant isolation. Default false = inert (SQLite
# dev/CI, or Postgres without RLS). See docs/MULTI-TENANT-DO-NOW.md.
ENABLE_RLS=false

# --- App ---
ENVIRONMENT=development

# --- MCP surface (off by default) ---
# Set to true only when you want to expose the /mcp agent surface.
MCP_ENABLED=false
