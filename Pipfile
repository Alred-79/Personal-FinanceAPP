[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
uvicorn = "*"
fastapi = "*"
pydantic-settings = "*"
fastapi-cors = "*"
pandas = "*"
groq = "*"
langchain = "*"
# The core assistant agent imports from ``langchain_classic`` (the legacy
# ConversationBufferWindowMemory + create_tool_calling_agent / AgentExecutor that
# LangChain 1.0 split out of the top-level ``langchain`` package). It is a real,
# separately-distributed package and is NOT pulled in transitively by ``langchain``
# 1.3.x, so it must be declared explicitly or a fresh install breaks the assistant.
langchain-classic = "*"
langchain_groq = "*"
pyjwt = "*"
passlib = "*"
python-multipart = "*"
bcrypt = "<4.1"
plaid-python = "*"
sqlalchemy = "*"
alembic = "*"
# Postgres driver (psycopg 3). Declared for the multi-tenant Postgres target; the
# app still defaults to SQLite, so this is only required once DATABASE_URL points
# at Postgres. Install with: ./.venv/bin/pip install "psycopg[binary]"
psycopg = {extras = ["binary"], version = "*"}
cachetools = "*"
slowapi = "*"
limits = "*"
email-validator = "*"
tavily-python = "*"
fastmcp = "*"
apscheduler = "*"
# F2 — Merchant Lifecycle Engine (pooled BG/NBD). The fit runs ONLY in F3's
# nightly batch, gated behind ``merchant_lifecycle_enabled`` (never a request
# path). The BG/NBD likelihood is built directly in core ``pymc`` (the
# ``pymc-marketing`` BetaGeoModel wrapper is incompatible with the installed
# pytensor on Python 3.13); ``scipy`` supplies the hypergeometric used by
# expected_purchases.
pymc = "*"
scipy = "*"

[dev-packages]
black = "*"
pytest = "*"
pytest-asyncio = "*"
# Per-test timeout so a deadlock-prone test (e.g. cross-connection on Postgres)
# fails fast instead of hanging the suite. Used as `pytest --timeout=60`.
pytest-timeout = "*"
httpx = "*"
# Property-based tests for the money/forecast invariant layer (server/src/money.py
# round-tripping, banker's rounding) — generative coverage of edge cases that
# example-based tests miss.
hypothesis = "*"
# Static analysis / supply-chain scanners (audit L-Part-C). Config in ruff.toml
# and .pre-commit-config.yaml. CI runs ruff + bandit + pip-audit (see
# .github/workflows/ci.yml). Introduced in report-not-autofix mode — a baseline
# ruleset only — so they surface issues without churning the existing tree.
ruff = "*"
bandit = "*"
pip-audit = "*"
pre-commit = "*"

[requires]
python_version = "3.13"

[scripts]
tailwind = "npx tailwindcss -i ./client/src/input.css -o ./client/src/output.css --watch"
frontend = "npm run dev"
server = "uvicorn server.src.main:app --reload"
format = "black ."
